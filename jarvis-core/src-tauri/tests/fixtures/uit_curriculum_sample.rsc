:"flex-start"},"children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-mail h-4 w-4 shrink-0","style":{"color":"#8fb6e8","marginTop":"3px"},"children":[["$","rect","18n3k1",{"width":"20","height":"16","x":"2","y":"4","rx":"2"}],["$","path","1ocrg3",{"d":"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"}],"$undefined"]}],["$","a",null,{"href":"mailto:info@uit.edu.vn","className":"hover:text-white no-underline transition-colors","style":{"fontSize":"13.5px","color":"#cfe1f5","lineHeight":1.6},"children":"info@uit.edu.vn"}]]}]]}]]}]]}],["$","div",null,{"className":"footer-bottom","style":{"borderTop":"1px solid rgba(255,255,255,.12)","padding":"14px 20px","textAlign":"center","fontSize":"12px","color":"rgba(207,225,245,0.7)"},"children":["$","div",null,{"className":"footer-copyright","children":[["$","span",null,{"className":"footer-copy-full","children":["© ",2026," Trường Đại học Công nghệ Thông tin — ĐHQG-HCM. Bản quyền thuộc về Trường Đại học Công nghệ Thông tin."]}],["$","span",null,{"className":"footer-copy-short","children":["© ",2026," UIT"]}]]}]}]]}],["$","$L12",null,{}]]}]
