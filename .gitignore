cat << 'EOF' > .gitignore
# Node & Build artifacts
node_modules/
dist/
dist-ssr/
*.local

# Rust & Cargo build artifacts
src-tauri/target/
**/*.rs.bk
Cargo.lock

# Tauri build outputs
src-tauri/binaries/
src-tauri/gen/

# SQLite Databases & WAL files (giữ dữ liệu local không đẩy lên repo)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# IDE & OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.log

# Environment variables
.env
.env.*
!.env.example
EOF